{
  "expo": {
    "name": "World_Wise",
    "slug": "World_Wise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app_images/icon.png",
    "scheme": "worldwise",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/app_images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app_images/icon.png",
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.worldwise.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/app_images/splashScreen.jpg",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "059c4d48-1de2-4209-8942-bcebf549edd0"
      }
    }
  }
}
